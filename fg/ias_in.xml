<?xml version="1.0"?>
<!-- Intelligent Autopilot System -> FlightGear (control commands). Install in $FG_ROOT/Protocol/ -->
<PropertyList>
 <generic>
  <input>
   <line_separator>newline</line_separator>
   <var_separator>,</var_separator>
   <chunk><name>aileron</name><type>double</type><format>%f</format><node>/controls/flight/aileron</node></chunk>
   <chunk><name>elevator</name><type>double</type><format>%f</format><node>/controls/flight/elevator</node></chunk>
   <chunk><name>rudder</name><type>double</type><format>%f</format><node>/controls/flight/rudder</node></chunk>
   <chunk><name>throttle</name><type>double</type><format>%f</format><node>/controls/engines/current-engine/throttle</node></chunk>
   <chunk><name>throttle0</name><type>double</type><format>%f</format><node>/controls/engines/engine[0]/throttle</node></chunk>
   <chunk><name>flaps</name><type>double</type><format>%f</format><node>/controls/flight/flaps</node></chunk>
   <chunk><name>brake_left</name><type>double</type><format>%f</format><node>/controls/gear/brake-left</node></chunk>
   <chunk><name>brake_right</name><type>double</type><format>%f</format><node>/controls/gear/brake-right</node></chunk>
  </input>
 </generic>
</PropertyList>
